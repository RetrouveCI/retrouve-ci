{
	"extends": "@app/typescript-config/react-router.json",
	"compilerOptions": {
		"rootDirs": [".", "./.react-router/types"],
		"paths": {
			"@/*": ["./app/*"],
			"@app/ui": ["../../packages/ui/src/index.ts"],
			"@app/ui/components": ["../../packages/ui/src/components/index.ts"],
			"@app/ui/components/form": [
				"../../packages/ui/src/components/form/index.ts"
			],
			"@app/ui/utils": ["../../packages/ui/src/utils/cn.ts"],
			"@app/ui/hooks": ["../../packages/ui/src/hooks/index.ts"]
		}
	},
	"include": [
		".react-router/types/**/*",
		"**/*.ts",
		"**/*.tsx",
		"vite.config.ts"
	],
	"exclude": [
		"node_modules",
		"build",
		"app/routes/account/stickers/_index.tsx",
		"app/routes/account/orders/**"
	]
}
