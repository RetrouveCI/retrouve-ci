{
	"extends": "@app/typescript-config/base.json",
	"compilerOptions": {
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"declaration": false,
		"declarationMap": false
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules"]
}
