{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck.sh\"",
						"timeout": 120,
						"statusMessage": "Typechecking..."
					},
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\"",
						"timeout": 15,
						"statusMessage": "Formatting (prettier)..."
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.sh\"",
						"timeout": 5
					}
				]
			}
		]
	}
}
