# Where the API lives. Read at RUNTIME (`process.env`), not baked at build time,
# so one image serves every environment. Required — the server refuses to start
# without it rather than silently calling its own origin.
API_URL="http://localhost:3002"

# La moitié publique de la paire VAPID, recopiée depuis le `.env` de l'API. Lue
# au RUNTIME comme `API_URL`, jamais via `import.meta.env` : elle voyage jusqu'au
# navigateur dans `PublicEnv`. Non renseignée, l'option d'activation des
# notifications sur un appareil se désactive et dit laquelle des quatre raisons
# s'applique, plutôt que d'afficher un bouton mort.
VAPID_PUBLIC_KEY=
