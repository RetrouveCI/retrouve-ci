{
	"name": "@app/api",
	"version": "1.0.0",
	"private": true,
	"type": "commonjs",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "nest build && tsc-alias -p tsconfig.build.json",
		"dev": "concurrently \"tsc-alias -p tsconfig.build.json -w\" \"nest start --watch\"",
		"start": "node dist/main.js",
		"docker:build": "docker build -f Dockerfile -t retrouveci-api:local ../..",
		"lint": "eslint",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@fastify/multipart": "catalog:",
		"@nestjs/bullmq": "catalog:",
		"@nestjs/common": "catalog:",
		"@nestjs/config": "catalog:",
		"@nestjs/core": "catalog:",
		"@nestjs/platform-fastify": "catalog:",
		"@nestjs/swagger": "catalog:",
		"@app/auth": "workspace:*",
		"@app/contracts": "workspace:*",
		"@app/database": "workspace:*",
		"@thallesp/nestjs-better-auth": "catalog:",
		"better-auth": "catalog:",
		"bullmq": "catalog:",
		"cloudinary": "catalog:",
		"dotenv": "catalog:",
		"fastify": "catalog:",
		"reflect-metadata": "catalog:",
		"rxjs": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@nestjs/cli": "catalog:",
		"@nestjs/schematics": "catalog:",
		"@nestjs/testing": "catalog:",
		"@app/eslint-config": "workspace:*",
		"@app/typescript-config": "workspace:*",
		"@app/vitest-config": "workspace:*",
		"@types/node": "catalog:",
		"concurrently": "catalog:",
		"eslint": "catalog:",
		"source-map-support": "catalog:",
		"tsc-alias": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
