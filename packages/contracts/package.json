{
	"name": "@app/contracts",
	"version": "0.0.0",
	"private": true,
	"type": "commonjs",
	"files": [
		"dist"
	],
	"exports": {
		"./*": {
			"types": "./src/*/index.ts",
			"import": "./src/*/index.ts",
			"require": "./dist/*/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@app/typescript-config": "workspace:*",
		"@app/vitest-config": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
