# Where the API lives. Read at RUNTIME (`process.env`), not baked at build time,
# so one image serves every environment. Required — the server refuses to start
# without it rather than silently calling its own origin.
API_URL="http://localhost:3002"

# The PUBLIC app's origin, which is what a scanned QR code resolves to. Only the
# QR screens use it. Defaults to https://retrouveci.com when unset.
PUBLIC_APP_URL="http://localhost:3000"

# The backoffice's own public origin, used to make the emailed password-reset
# link absolute. Falls back to the request's origin when unset.
ADMIN_APP_URL="http://localhost:3001"
