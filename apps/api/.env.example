# DATABASE
DATABASE_URL="postgresql://retrouveci:retrouveci@localhost:5432/retrouveci?schema=public"

REDIS_URL="redis://localhost:6379"

# BETTER AUTH
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3002"

# Origines depuis lesquelles le backoffice est servi (CSV). L'API s'en sert pour
# savoir laquelle des deux sessions lire. REQUIS en production : sans valeur,
# l'API refuse de démarrer.
ADMIN_ORIGINS="http://localhost:3001"

# Origines des deux front-ends (CSV). Pilote CORS *et* les `trustedOrigins` de
# better-auth : les deux répondent à la même question, et tenir deux listes en
# phase est ce qui a fait qu'en production aucune des deux n'autorisait rien.
# REQUIS en production : sans valeur, l'API refuse de démarrer.
# (`BETTER_AUTH_TRUSTED_ORIGINS` n'est plus lu par cette app.)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Domaine parent du cookie de session, ex. ".retrouveci.com". Requis en
# production dès que l'API et les fronts n'ont pas le même hôte.
COOKIE_DOMAIN=

# USER SEEDER
# Le compte qui administre la plateforme, créé au démarrage s'il n'existe pas.
# L'e-mail et le mot de passe sont REQUIS en production : sans eux l'API refuse
# de démarrer, plutôt que de créer un admin avec les valeurs ci-dessous, qui
# sont publiques puisqu'elles vivent dans ce dépôt. Une fois le compte créé, le
# mot de passe n'est plus lu et peut être retiré de l'environnement.
SUPER_ADMIN_EMAIL="admin@retrouveci.ci"
SUPER_ADMIN_PASSWORD="admin1234"
SUPER_ADMIN_NAME="Super Admin"

# Fixture de développement, JAMAIS créée en production : mot de passe publié et
# aucun usage métier.
SEED_MOCK_USER_EMAIL="test@retrouveci.ci"
SEED_MOCK_USER_PASSWORD="test1234"
SEED_MOCK_USER_NAME="Utilisateur Test"
SEED_MOCK_USER_PHONE="+2250700000001"


# Cloudinary — stockage des photos d'objets
CLOUDINARY_CLOUD_NAME= 
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# Passerelle SMS des OTP par téléphone (Letexto). Les trois sont requises en
# production : l'API refuse de démarrer sans elles, car une connexion incapable
# de délivrer son code est pire qu'un échec au démarrage. Laissées vides en
# développement, le code est écrit dans la console à la place.
# LETEXTO_API_SENDER est le nom d'expéditeur validé qui s'affiche sur le SMS.
LETEXTO_API_URL=https://apis.letexto.com/v1/messages/send
LETEXTO_API_KEY=
LETEXTO_API_SENDER="Retrouveci"
