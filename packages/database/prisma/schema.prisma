
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


enum LostItemType {
  LOST
  FOUND
}

enum LostItemCategory {
  PHONE
  KEYS
  WALLET
  BAG
  ELECTRONICS
  DOCUMENTS
  OTHER
}

enum DocumentType {
  NATIONAL_ID
  DRIVER_LICENCE
  BANK_CARD
  INSURANCE_CARD
  PASSPORT
  STUDENT_CARD
  OTHER
}

enum ModerationReason {
  DOCUMENT_NUMBER_VISIBLE
  UNCLEAR_PHOTO
  VAGUE_DESCRIPTION
  CONTACT_IN_DESCRIPTION
  DUPLICATE
  OFF_TOPIC
  OTHER
}

enum ModerationStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum ResolutionStatus {
  ACTIVE
  RESOLVED
  EXPIRED
}

enum QrTokenStatus {
  GENERATED
  ACTIVATED
  REVOKED
}

enum StickerOrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Where a sale came from. DIRECT is what an order carries when no marker came,
/// including every row written before A6 — nobody knows where those came from.
enum StickerOrderSource {
  HOME
  STICKERS_PAGE
  ACCOUNT
  DIRECT
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

enum NotificationType {
  MATCH_FOUND
  QR_SCAN
  STICKERS_DELIVERED
  LISTING_PENDING
  LISTING_MODERATED
  LISTING_CONTACTED
  ORDER_PLACED
  CONTACT_RECEIVED
  ORDER_PROCESSING
  ORDER_SHIPPED
  ORDER_CANCELLED
  LISTING_COMMENTED
  LISTING_REPLIED
}

/// Who a notification speaks to. An ADMIN row carries no userId: it addresses
/// the desk, so the first administrator who reads it reads it for all.
enum NotificationAudience {
  USER
  ADMIN
}

/// Which app a comment was written from. Stored, never deduced from the author:
/// an administrator is also an ordinary user, and posts as one on the public app.
enum ListingCommentSide {
  ADMIN
  OWNER
}

model User {
  id                  String     @id
  name                String
  email               String
  emailVerified       Boolean    @default(false)
  image               String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  phoneNumber         String?
  phoneNumberVerified Boolean?
  city                String?
  commune             String?
  role                String?
  banned              Boolean?   @default(false)
  banReason           String?
  banExpires          DateTime?
  sessions            Session[]
  accounts            Account[]
  lostItems           LostItem[]
  qrTokens            QrToken[]
  stickerOrders       StickerOrder[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  listingComments     ListingComment[]

  @@unique([email])
  @@unique([phoneNumber])
  @@map("user")
}

model Session {
  id              String   @id
  expiresAt       DateTime
  token           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ipAddress       String?
  userAgent       String?
  impersonatedBy  String?
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}



model LostItem {
  id                   String            @id @default(uuid())
  type                 LostItemType
  category             LostItemCategory
  title                String
  description          String
  ville                String
  commune              String?
  eventDate            DateTime
  contactName          String
  contactWhatsapp      String
  photos               String[]          @default([])
  documentType         DocumentType?
  documentHolderName   String?
  documentNumber       String?
  documentIssuer       String?
  moderationStatus     ModerationStatus  @default(PENDING)
  moderationReason     ModerationReason?
  moderationReasonNote String?
  resolutionStatus     ResolutionStatus  @default(ACTIVE)
  /// When the owner marked it handed back; null before A5 and while active.
  /// updatedAt moves on every edit, so it could never answer « ce mois ».
  resolvedAt           DateTime?
  views                Int               @default(0)
  contactsCount        Int               @default(0)
  /// Published by the team rather than by a visitor. Carried to the public
  /// projection on purpose: it is what the badge reads.
  official             Boolean           @default(false)
  /// Who the team published on behalf of. Never public — the projection
  /// withholds it, and its spec asserts the omission.
  postedFor            String?
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  qrTokens             QrToken[]
  comments             ListingComment[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([userId])
  @@index([type, moderationStatus, resolutionStatus])
  @@index([type, moderationStatus, resolutionStatus, category])
  @@map("lost_item")
}

/// A suggestion between the desk and a poster — not a moderation decision,
/// which keeps its own reason. readAt is set when the other side reads it.
model ListingComment {
  id         String             @id @default(uuid())
  lostItemId String
  lostItem   LostItem           @relation(fields: [lostItemId], references: [id], onDelete: Cascade)
  /// Null once the author's account is gone: the thread belongs to the listing,
  /// and authorSide still says who wrote.
  authorId   String?
  author     User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorSide ListingCommentSide
  body       String
  createdAt  DateTime           @default(now())
  readAt     DateTime?

  @@index([lostItemId, createdAt])
  @@index([authorId])
  @@map("listing_comment")
}



model QrToken {
  id            String        @id @default(uuid())
  code          String        @unique
  status        QrTokenStatus @default(GENERATED)
  batch         String?
  label         String?
  linkedObject  String?
  directContact Boolean       @default(false)
  lostItemId    String?
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  lostItem      LostItem?     @relation(fields: [lostItemId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  activatedAt   DateTime?
  revokedAt     DateTime?
  lastScannedAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([lostItemId])
  @@map("qr_token")
}



model StickerOrder {
  id              String             @id @default(uuid())
  orderNumber     String             @unique
  packId          String
  packName        String
  quantity        Int
  unitPrice       Int
  deliveryFee     Int
  total           Int
  status          StickerOrderStatus @default(PENDING)
  source          StickerOrderSource @default(DIRECT)
  paymentMethod   String
  deliveryAddress String
  deliveryCity    String
  deliveryNotes   String?
  trackingNumber  String?
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  shippedAt       DateTime?
  deliveredAt     DateTime?

  @@index([userId])
  @@index([status])
  @@map("sticker_order")
}



model Notification {
  id        String               @id @default(uuid())
  type      NotificationType
  audience  NotificationAudience @default(USER)
  title     String
  message   String
  link      String?
  read      Boolean              @default(false)
  userId    String?
  user      User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime             @default(now())
  readAt    DateTime?

  @@index([userId])
  @@index([userId, read])
  @@index([audience, read])
  @@map("notification")
}

// One row per browser, keyed on the endpoint the vendor issued. It records a
// capability the visitor granted, not an audience measurement.
model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_subscription")
}

model ContactMessage {
  id              String               @id @default(uuid())
  name            String
  email           String?
  phone           String?
  subject         String
  message         String
  status          ContactMessageStatus @default(NEW)
  qrTokenCode     String?
  recipientUserId String?
  createdAt       DateTime             @default(now())
  readAt          DateTime?

  @@index([status])
  @@index([recipientUserId])
  @@index([qrTokenCode])
  @@map("contact_message")
}
