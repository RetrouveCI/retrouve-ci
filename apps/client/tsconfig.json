{
	"compilerOptions": {
		"lib": ["dom", "dom.iterable", "esnext"],
		"types": ["vitest/globals", "vite/client"],
		"allowJs": true,
		"target": "ES2022",
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"rootDirs": [".", "./.react-router/types"],
		"paths": {
			"@/*": ["./app/*"],
			"@app/ui": ["../../packages/ui/src/index.ts"],
			"@app/ui/components": ["../../packages/ui/src/components/index.ts"],
			"@app/ui/components/form": [
				"../../packages/ui/src/components/form/index.ts"
			],
			"@app/ui/utils": ["../../packages/ui/src/utils/cn.ts"],
			"@app/ui/hooks": ["../../packages/ui/src/hooks/index.ts"]
		}
	},
	"include": [
		".react-router/types/**/*",
		"**/*.ts",
		"**/*.tsx",
		"vite.config.ts"
	],
	"exclude": [
		"node_modules",
		"build",
		"app/routes/account/stickers/_index.tsx",
		"app/routes/account/orders/**"
	]
}
